# SupabaseプロジェクトのDB接続文字列
# Supabaseダッシュボード > Project Settings > Database > Connection string から取得
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres"

# Supabase Storage用（フロア図画像）。認証はAuth.jsに移行したため、ここはStorageのためだけに使う
# ダッシュボード > Project Settings > API Keys から取得（sb_publishable_... という形式）
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"

# サーバー側のみで使う秘密鍵（旧service_role keyの後継）。NEXT_PUBLIC_を付けず、絶対にクライアントに露出させない
# フロア図アップロードAPI（/api/floors/[floorId]/image）がStorageへの書き込みに使用する
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxx"

# Auth.js（認証）用
# AUTH_SECRETはセッションCookieの署名に使う。`npx auth secret` または
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"` で生成する
AUTH_SECRET="xxxxxxxx"

# Google Cloud Console > APIとサービス > 認証情報 のOAuthクライアントID/シークレット。
# 「承認済みのリダイレクトURI」に以下を登録しておくこと：
#   http://localhost:3000/api/auth/callback/google
#   https://<本番ドメイン>/api/auth/callback/google
AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="xxxxxxxx"
