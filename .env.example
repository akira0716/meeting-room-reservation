# SupabaseプロジェクトのDB接続文字列
# Supabaseダッシュボード > Project Settings > Database > Connection string から取得
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres"

# Supabase Auth用（フロント/サーバー両方から使う公開情報）
# publishable key は旧anon keyの後継（Supabaseは2026年末までにanon/service_roleキーを廃止予定のため、新規プロジェクトはこちらを使う）
# ダッシュボード > Project Settings > API Keys から取得（sb_publishable_... という形式）
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"

# サーバー側のみで使う秘密鍵（旧service_role keyの後継）。NEXT_PUBLIC_を付けず、絶対にクライアントに露出させない
# 今回のMVPでは未使用（RLSをバイパスする管理操作が必要になったら使う）
# SUPABASE_SECRET_KEY="sb_secret_xxxxxxxx"
